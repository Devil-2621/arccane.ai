# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="your-db-url"

# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com/
#put your keys here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in" # your sign-in page path
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up" # your sign-up page path
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/" # redirect after sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/" # redirect after sign-up

# API KEYS
# Get your API key from: https://platform.openai.com/api-keys
#OpenAI API Key
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# or

# Google Gemini API
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: OpenRouter API (Alternative AI Provider)
# Get your API key from: https://openrouter.ai/
# OPENROUTER_API_KEY="sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Anthropic Claude API (Alternative AI Provider)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# E2B Code Sandboxes
# Get your API key from: https://e2b.dev/dashboard
E2B_API_KEY="e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Application URLs
# Local development URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
